# Nostr Relay Configuration
NEXT_PUBLIC_NIP29_RELAY_URL=wss://groups.contextio.app

# App Configuration
NEXT_PUBLIC_APP_NAME=Nostr Team Chat
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Logging Configuration
# Options: 'none' | 'error' | 'warn' | 'info' | 'debug'
# Default: 'none' in production, 'debug' in development
NEXT_PUBLIC_LOG_LEVEL=none

# PostHog Analytics (optional)
# Get your key from https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
